# Node / React
node_modules/

dist/
build/
.env*
!.env.example
!.env.local.example
!.env.lambda.example
!.env.production

# PWA icons (downloaded separately)
frontend/public/icons/*.png
mobile/android/
mobile/ios/

# Python
__pycache__/
*.py[cod]
.venv/
.venv-lambda-check/
venv/
.env/
.pytest_cache/
htmlcov/

# CDK / CloudFormation
# Root-level CDK outputs (if ever generated)
cdk.out/
# CDK app subfolder outputs
cdk/cdk.out/
cdk/cdk.out.backend/
.cdk.out/

# IDE / OS
.DS_Store
*.swp
.idea/
.vscode/

# Data directory managed externally
data/*
!data/accounts/
!data/accounts/**
!data/instruments/
!data/instruments/**
!data/prices/
!data/prices/**
!data/scaling_overrides.json
!data/events.json
!data/trail.json
!data/queries/
!data/queries/**

# Local dev instance port coordination (see #5760)
/.local/

# Logs
backend.log
# Keep the directory itself tracked (via logs/.gitkeep) so it exists on a
# fresh checkout, even for entry points that don't create it themselves
# (e.g. invoking uvicorn directly with --log-config backend/logging.ini).
/logs/*
!/logs/.gitkeep
/tests/.coverage
/.coverage
/.coveragerc
/coverage/
/test-results/

# Jenkins
jenkins_home/
.aider*
!.aiderignore

# Kun canvas/whiteboard tool artifacts (agent workspace state, not repo content)
.kun-canvas/

# Graphify's internal incremental-build cache (hundreds of small per-file
# blobs, not meaningful output) — only graph.json/manifest.json etc. from
# graphify-out/ should ever be committed, see #6119.
graphify-out/cache/
# graphify also writes a dated snapshot subfolder duplicating the same
# files (graphify-out/2026-08-05/, etc). We only want one flat folder of
# current results, not split by date, see #6131.
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# Offline issue sync
issues/
/data/queries/test-query.json

coverage.xml
/.issue-*.md
/frontend/test-results/.last-run.json
/frontend/test-results/
/scripts/developer_tools/scripts/developer_tools/.coverage
/scripts/developer_tools/test-results/junit.xml
/.issue-worm/
.env
